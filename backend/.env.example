# Database (matches the local PostgreSQL service in docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5433/codeowl
DB_USERNAME=postgres
DB_PASSWORD=postgres

# GitHub OAuth application credentials.
# Configure this application's callback URL as:
# http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# AI provider: `openai` (default) or `google-genai` (Gemini Developer API).
# OpenAI vectors use 1536 dimensions; Gemini output is reduced to 768 for pgvector.
AI_PROVIDER=google-genai
AI_EMBEDDING_DIMENSIONS=768

# OpenAI API key used when AI_PROVIDER=openai.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Gemini Developer API key used when AI_PROVIDER=google-genai.
# gemini-embedding-001 is requested at 768 dimensions (pgvector supports up to 2000).
GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Used to encrypt GitHub access tokens at rest. Keep these stable once data exists.
# TOKEN_ENCRYPTOR_SALT must be a 16-character hexadecimal value.
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-secret
TOKEN_ENCRYPTOR_SALT=0123456789abcdef

# Frontend address used for OAuth redirects and CORS. Comma-separate multiple CORS origins.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional indexing tuning.
INDEXING_MAX_FILE_BYTES=102400
INDEXING_CHUNK_SIZE=800
INDEXING_CHUNK_OVERLAP=100
GITHUB_API_DELAY_MS=1000
